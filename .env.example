# Database (matches docker-compose portal-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal"

# API server
PORT=8000
NODE_ENV=development
BASE_URL="http://localhost:8000"

# Web (optional) — base URL of the API's tRPC endpoint
# NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"

# Auth — sign access & password-reset JWTs; use a long random value in prod
JWT_SECRET="change-me"
# Google OAuth web client id — required for "Sign in with Google"
# GOOGLE_CLIENT_ID=""

# CORS (prod only) — comma-separated allowed browser origins; dev allows all.
# Unset in prod = no CORS headers (native mobile clients are unaffected).
# ALLOWED_ORIGINS="https://app.example.com"

# Rate limiting on auth endpoints (login/signup/google/password-reset)
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MIN=15

# Minutes before an unanswered PENDING visitor request auto-expires
# VISITOR_PENDING_TTL_MIN=15

# Shared secret for verifying payment-gateway webhook signatures
PAYMENT_WEBHOOK_SECRET="change-me-webhook"

# Echo email-verification OTP codes in login/resend responses. DEV ONLY — in a
# real deployment leave this unset so codes only ever go out by email.
# OTP_DEV_ECHO="true"

# SMTP mailer — delivers OTP + password-reset emails. Unset = emails are logged
# and skipped (dev fallback: use OTP_DEV_ECHO / server logs for the token).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"          # "true" for implicit TLS on port 465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Portl Society <no-reply@example.com>"

# Cloudinary — signed direct uploads (avatars, visitor/ticket/notice photos).
# Unset = uploads disabled (412) and media-URL validation skipped in dev.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
