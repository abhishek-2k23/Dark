# Database (matches docker-compose portal-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal"

# API server
PORT=8000
NODE_ENV=development
BASE_URL="http://localhost:8000"

# Keep-alive — Render's free tier idles an instance after 15 min without an
# inbound request, and the next caller pays a cold start. In prod the server
# pings its own public /health on this interval to stay warm. Must be < 15.
# Set to 0 to disable (paid instances never idle). Ignored outside prod.
# KEEP_ALIVE_INTERVAL_MIN=10
# Override the ping target; defaults to BASE_URL + /health. Must be the PUBLIC
# url — a loopback request never reaches Render's router, so it doesn't count.
# KEEP_ALIVE_URL="https://your-service.onrender.com/health"

# Web (optional) — base URL of the API. The web app derives its REST calls
# (e.g. the account-deletion flow) from this origin; a trailing /trpc is ignored.
# NEXT_PUBLIC_API_URL="http://localhost:8000"

# Mobile (optional) — base URL of the web app the mobile Profile tab links to
# for the Privacy, Terms, Help, and Delete-Account pages. Defaults to the
# deployed web app in app.config.ts / eas.json.
# EXPO_PUBLIC_WEB_URL="https://prangan.iamabhishek01.dev"

# Auth — sign access & password-reset JWTs; use a long random value in prod
JWT_SECRET="change-me"

# Google OAuth WEB client id — required for "Sign in with Google".
# The server verifies each ID token's `aud` claim against this exact value, so
# it MUST be identical to the app's EXPO_PUBLIC_GOOGLE_CLIENT_ID below. Unset =
# the endpoint returns 412 rather than accepting anything.
# GOOGLE_CLIENT_ID=""

# The mobile app needs this SAME web client id, but it does NOT read this file:
# Expo only loads .env from the app directory. Set it in apps/portal/.env
# (see apps/portal/.env.example), and in eas.json for remote builds.

# CORS (prod only) — comma-separated allowed browser origins; dev allows all.
# Unset in prod = no CORS headers (native mobile clients are unaffected). MUST
# include the web app's origin so its account-deletion calls aren't blocked.
# ALLOWED_ORIGINS="https://prangan.iamabhishek01.dev"

# Rate limiting on auth endpoints (login/signup/google/password-reset)
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MIN=15

# Minutes before an unanswered PENDING visitor request auto-expires
# VISITOR_PENDING_TTL_MIN=15

# Shared secret for verifying payment-gateway webhook signatures
PAYMENT_WEBHOOK_SECRET="change-me-webhook"

# --- Razorpay Route (gateway rail) ---------------------------------------
# Leave all of these unset for local dev: the payment pipeline falls back to
# the MOCK gateway, so every flow stays exercisable without an account.
#
# NOTE: Route is a separate feature you must request from Razorpay support —
# valid keys alone are not enough. Without it, linked-account creation returns
# "Route feature not enabled for the merchant" and only the UPI-direct and
# offline rails work. See docs/payments.md.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Generated in the Razorpay dashboard when you create the webhook. The
# signature is an HMAC over the RAW request body — see apps/api/src/server.ts.
RAZORPAY_WEBHOOK_SECRET=""
# Platform fee in basis points (200 = 2%). Default 0 — we take no cut and the
# society bears Razorpay's own fees (docs/payments.md §6).
PLATFORM_FEE_BPS="0"

# Echo email-verification OTP codes in login/resend responses. DEV ONLY — in a
# real deployment leave this unset so codes only ever go out by email.
# OTP_DEV_ECHO="true"

# SMTP mailer — delivers OTP + password-reset emails. Unset = emails are logged
# and skipped (dev fallback: use OTP_DEV_ECHO / server logs for the token).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"          # "true" for implicit TLS on port 465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Prangan <no-reply@example.com>"

# Cloudinary — signed direct uploads (avatars, visitor/ticket/notice photos).
# Unset = uploads disabled (412) and media-URL validation skipped in dev.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
