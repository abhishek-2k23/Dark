# Database (matches docker-compose portal-postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal"

# API server
PORT=8000
NODE_ENV=development
BASE_URL="http://localhost:8000"

# Web (optional) — base URL of the API's tRPC endpoint
# NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"

# Auth — sign access & password-reset JWTs; use a long random value in prod
JWT_SECRET="change-me"
# Google OAuth web client id — required for "Sign in with Google"
# GOOGLE_CLIENT_ID=""
