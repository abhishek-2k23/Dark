# Template for apps/portal/.env — copy to `.env` and fill in.
#
# Expo reads .env from THIS directory only. EXPO_PUBLIC_* vars set in the
# monorepo root .env never reach app.config.ts or Metro, so they belong here.
#
# EAS builds don't get this file at all (it's gitignored, and EAS falls back to
# .gitignore when there's no .easignore) — the values for remote builds live in
# eas.json under each profile's `env`. Keep the two in sync.

# Google OAuth WEB client id — not the Android or iOS one. The native SDK takes
# it as `serverClientID` and stamps it into the ID token's `aud` claim, which the
# API verifies against its own GOOGLE_CLIENT_ID (root .env). The two must match
# exactly, or sign-in succeeds on device and every API call then 401s.
# Not a secret: it ships inside the app binary.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=""

# iOS only. Leave both unset for Android-only builds — the google-signin config
# plugin is skipped entirely while the url scheme is empty. The scheme is the
# iOS client id reversed.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME="com.googleusercontent.apps.xxxxx"

# Optional overrides; defaults live in app.config.ts.
# EXPO_PUBLIC_API_URL="http://localhost:8000"
# EXPO_PUBLIC_WEB_URL="https://prangan.iamabhishek01.dev"
