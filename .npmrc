# Expo SDK 56 / React Native 0.85 use a Metro version with native symlink
# support, so pnpm's default isolated node_modules works in this monorepo
# together with apps/portal/metro.config.js. A couple of packages are hoisted
# to the root so Expo's CLI and config plugins resolve them reliably.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@babel/*
public-hoist-pattern[]=*metro*
