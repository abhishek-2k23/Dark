generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  RESIDENT
  GUARD
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum FlatType {
  ONE_RK    @map("1RK")
  ONE_BHK   @map("1BHK")
  TWO_BHK   @map("2BHK")
  THREE_BHK @map("3BHK")
  FOUR_BHK  @map("4BHK")
  OTHER
}

enum VehicleType {
  CAR
  BIKE
  OTHER
}

enum InviteStatus {
  PENDING
  CLAIMED
}

enum VisitorPurpose {
  GUEST
  DELIVERY
  CAB
  SERVICE_STAFF
  OTHER
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum PreApprovalStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  HOUSEKEEPING
  SECURITY
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NoticeCategory {
  MAINTENANCE
  EVENT
  EMERGENCY
  GENERAL
}

enum BookingStatus {
  // Chargeable amenities only: the slot is held while payment is outstanding.
  // Overlap checks treat this as occupying the slot, so two residents can't
  // both pay for it. Free amenities go straight to BOOKED.
  PENDING_PAYMENT
  BOOKED
  CANCELLED
  // A PENDING_PAYMENT hold that lapsed before payment landed; slot released.
  EXPIRED
  COMPLETED
}

enum DueStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  // Gateway methods — money moves through Razorpay and settles to the payee's
  // linked account. Only these ever produce a checkout session.
  UPI
  CARD
  NETBANKING
  // Peer-to-peer UPI: the payer opens their own UPI app via a deep link and
  // pays the payee's VPA directly. We never touch the money, so the payer's
  // UTR is a claim that still has to be confirmed by a human.
  UPI_DIRECT
  // Paid outside the app (cash/cheque/direct transfer) and evidenced by an
  // uploaded receipt an admin has to verify. Never touches the gateway.
  OFFLINE
}

enum PaymentStatus {
  INITIATED
  // Manual rails only (OFFLINE, UPI_DIRECT): evidence submitted, waiting on a
  // human decision. The target stays payable until then, so nobody is marked
  // paid on their own say-so.
  PENDING_VERIFICATION
  SUCCESS
  FAILED
  // Manual rails only: a decision-maker turned the evidence down, or reversed
  // a self-attested payment. The target stays payable and the resident may
  // submit again.
  REJECTED
}

/**
 * How far along a payee is in Razorpay Route onboarding. Only ACTIVE accounts
 * can receive gateway money — Razorpay requires the account holder to complete
 * their own KYC form and passes a penny-test before that flips.
 */
enum PayoutOnboardingStatus {
  NOT_STARTED
  // Linked account created via API; the holder's KYC form is still outstanding.
  CREATED
  ACTIVE
  SUSPENDED
}

/**
 * A society's subscription to Portl itself.
 *
 * Unlike every other payment in this schema, this one is the society paying
 * *us* for our own software — we are an ordinary merchant here, not an
 * intermediary, so it needs no Route, no linked accounts, and none of the
 * payment-aggregator machinery that resident payments avoid.
 */
enum SubscriptionStatus {
  // Never subscribed, or a free evaluation period.
  TRIALING
  ACTIVE
  // Period ended, payment outstanding. Admins keep full access and are warned;
  // this window exists so a failed card does not lock a paying customer out.
  GRACE
  // Grace ran out. Admin writes are blocked; residents are unaffected and the
  // society's data is never withheld.
  EXPIRED
  // Deliberately ended by the admin; runs to the end of the paid period.
  CANCELLED
}

enum ServiceCategory {
  MAID
  ELECTRICIAN
  PLUMBER
  DRIVER
  OTHER
}

enum DeviceType {
  IOS
  ANDROID
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  // Permanent for that society: only an admin invite can let the user in after
  // this. Guards submitJoinRequest.
  REJECTED
  // The admin never answered within the TTL. The user may request again after
  // the cooldown (measured from the request's createdAt).
  EXPIRED
}

enum NotificationType {
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  VISITOR_PENDING
  VISITOR_APPROVED
  VISITOR_DENIED
  VISITOR_ARRIVED
  PAYMENT_SUBMITTED
  BOOKING_CANCELLED
  TICKET_RAISED
  TICKET_STATUS_CHANGED
  TICKET_COMMENT
  TICKET_ASSIGNED
  NOTICE_PUBLISHED
  POLL_CREATED
  DUE_GENERATED
  BOOKING_CONFIRMED
  // A resident raised a bill against a service person, or self-attested paying
  // one and an admin later reversed that.
  SERVICE_BILL_RAISED
  SERVICE_PAYMENT_REVERSED
  // A chargeable booking's payment hold lapsed and the slot was released.
  BOOKING_PAYMENT_EXPIRED
  // Society payouts: linked account went ACTIVE, or a transfer failed and left
  // money stranded in the platform balance (admin-facing, ops-critical).
  PAYOUT_ACTIVATED
  PAYOUT_TRANSFER_FAILED
  // Society's own subscription to Portl.
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  GENERAL
}

// ---------------------------------------------------------------------------
// CORE IDENTITY & SOCIETY HIERARCHY
// ---------------------------------------------------------------------------

model Society {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String
  city      String
  state     String
  pincode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Payouts ------------------------------------------------------------
  // Both are optional and independent: a society with neither still collects
  // money offline. Setting a VPA opens the UPI-direct rail; an ACTIVE linked
  // account opens the gateway rail.
  upiVpa            String?
  razorpayAccountId String?                @unique
  payoutStatus      PayoutOnboardingStatus @default(NOT_STARTED)

  towers           Tower[]
  users            User[]
  guardProfiles    GuardProfile[]
  adminProfiles    AdminProfile[]
  invites          PendingResidentInvite[]
  notices          Notice[]
  polls            Poll[]
  amenities        Amenity[]
  serviceProviders ServiceProvider[]
  joinRequests     SocietyJoinRequest[]
  subscription     Subscription?
}

model Tower {
  id        String   @id @default(cuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  flats Flat[]

  @@unique([societyId, name])
}

model Flat {
  id         String   @id @default(cuid())
  towerId    String
  tower      Tower    @relation(fields: [towerId], references: [id])
  flatNumber String
  floor      Int
  type       FlatType
  createdAt  DateTime @default(now())

  residents    ResidentProfile[]
  invites      PendingResidentInvite[]
  visitors     Visitor[]
  preApprovals GuestPreApproval[]
  tickets      HelpdeskTicket[]
  dues         MaintenanceDue[]

  @@unique([towerId, flatNumber])
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String?      @unique
  phone        String?      @unique
  passwordHash String? // null when authProvider = GOOGLE and no password set
  authProvider AuthProvider @default(LOCAL)
  googleId     String?      @unique
  avatarUrl    String?
  // Email ownership proven via an emailed OTP. Login with an *unverified* email
  // is gated behind OTP verification (phone login is not). GOOGLE accounts are
  // verified by Google, so they are seeded/created as verified.
  emailVerified Boolean     @default(false)
  role         Role
  societyId    String?
  society      Society?     @relation(fields: [societyId], references: [id])
  isActive     Boolean      @default(true)

  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  residentProfile ResidentProfile?
  guardProfile    GuardProfile?
  adminProfile    AdminProfile?
  pushTokens      PushToken[]
  refreshTokens   RefreshToken[]
  emailOtps       EmailOtp[]

  registeredVisitors    Visitor[]               @relation("VisitorRegisteredByGuard")
  approvedVisitors      Visitor[]               @relation("VisitorApprovedByResident")
  assignedTickets       HelpdeskTicket[]        @relation("TicketAssignee")
  ticketComments        TicketComment[]
  publishedNotices      Notice[]
  createdPolls          Poll[]
  sentInvites           PendingResidentInvite[]
  addedServiceProviders ServiceProvider[]
  verifiedPayments      Payment[]               @relation("PaymentVerifiedByAdmin")
  joinRequests          SocietyJoinRequest[]    @relation("JoinRequestUser")
  decidedJoinRequests   SocietyJoinRequest[]    @relation("JoinRequestDecidedBy")
  notifications         Notification[]
}

// ---------------------------------------------------------------------------
// ROLE-SPECIFIC PROFILES
// ---------------------------------------------------------------------------

model ResidentProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  flatId            String
  flat              Flat      @relation(fields: [flatId], references: [id])
  isPrimaryResident Boolean   @default(false)
  moveInDate        DateTime?

  familyMembers FamilyMember[]
  vehicles      Vehicle[]
  preApprovals  GuestPreApproval[]
  tickets       HelpdeskTicket[]
  pollVotes     PollVote[]
  bookings      AmenityBooking[]
  payments      Payment[]
  serviceBills  ServiceBill[]

  @@index([flatId])
}

model FamilyMember {
  id                String          @id @default(cuid())
  residentProfileId String
  residentProfile   ResidentProfile @relation(fields: [residentProfileId], references: [id])
  name              String
  relation          String
  age               Int?
  photoUrl          String?
}

model Vehicle {
  id                String          @id @default(cuid())
  residentProfileId String
  residentProfile   ResidentProfile @relation(fields: [residentProfileId], references: [id])
  number            String
  type              VehicleType

  @@unique([residentProfileId, number])
}

model GuardProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  societyId    String
  society      Society @relation(fields: [societyId], references: [id])
  gateAssigned String?
  shiftStart   String? // "HH:mm", 24h
  shiftEnd     String? // "HH:mm", 24h
}

model AdminProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  societyId   String
  society     Society @relation(fields: [societyId], references: [id])
  designation String?
}

// ---------------------------------------------------------------------------
// AUTH-SUPPORTING TABLES
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  ACCOUNT_DELETION
}

model EmailOtp {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  purpose   EmailOtpPurpose @default(EMAIL_VERIFICATION)
  codeHash  String // SHA-256 of the 6-digit code — never store the raw code
  expiresAt DateTime
  attempts  Int             @default(0) // wrong-code tries; consumed after a cap
  consumedAt DateTime?
  createdAt DateTime        @default(now())

  @@index([userId, purpose])
}

// A society-less user asking a society's admin to let them in. Created from
// the no-society screen by giving an admin's email; the admin approves (picking
// the flat) or rejects from their queue. Sibling to PendingResidentInvite,
// which is the admin-initiated direction and stays authoritative.
model SocietyJoinRequest {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation("JoinRequestUser", fields: [userId], references: [id])
  societyId        String
  society          Society           @relation(fields: [societyId], references: [id])
  status           JoinRequestStatus @default(PENDING)
  // PENDING requests past this moment are dead: hidden from the admin queue
  // and flipped to EXPIRED by the sweep.
  expiresAt        DateTime
  decidedByAdminId String?
  decidedByAdmin   User?             @relation("JoinRequestDecidedBy", fields: [decidedByAdminId], references: [id])
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())

  @@index([societyId, status])
  @@index([userId, createdAt])
}

model PendingResidentInvite {
  id               String       @id @default(cuid())
  societyId        String
  society          Society      @relation(fields: [societyId], references: [id])
  flatId           String
  flat             Flat         @relation(fields: [flatId], references: [id])
  email            String? // at least one of email/phone required — enforced in service layer
  phone            String?
  invitedByAdminId String
  invitedByAdmin   User         @relation(fields: [invitedByAdminId], references: [id])
  status           InviteStatus @default(PENDING)
  claimedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@index([email])
  @@index([phone])
  @@index([societyId, status])
}

// ---------------------------------------------------------------------------
// VISITOR MANAGEMENT
// ---------------------------------------------------------------------------

model Visitor {
  id                   String         @id @default(cuid())
  name                 String
  phone                String
  photoUrl             String?
  purpose              VisitorPurpose
  vehicleNumber        String?
  flatId               String
  flat                 Flat           @relation(fields: [flatId], references: [id])
  registeredByGuardId  String
  registeredByGuard    User           @relation("VisitorRegisteredByGuard", fields: [registeredByGuardId], references: [id])
  status               VisitorStatus  @default(PENDING)
  approvedByResidentId String?
  approvedByResident   User?          @relation("VisitorApprovedByResident", fields: [approvedByResidentId], references: [id])
  entryTime            DateTime?
  exitTime             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([flatId])
  @@index([status])
  @@index([registeredByGuardId])
}

model GuestPreApproval {
  id            String            @id @default(cuid())
  residentId    String
  resident      ResidentProfile   @relation(fields: [residentId], references: [id])
  flatId        String
  flat          Flat              @relation(fields: [flatId], references: [id])
  guestName     String
  guestPhone    String?
  // Optional: when given, the pass (QR + code) is emailed to the guest so they
  // can show it at the gate without the resident forwarding anything.
  guestEmail    String?
  validFrom     DateTime
  validTo       DateTime
  vehicleNumber String?
  qrCode        String            @unique
  status        PreApprovalStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())

  @@index([flatId, status])
  @@index([residentId])
}

// ---------------------------------------------------------------------------
// COMMUNITY MODULES
// ---------------------------------------------------------------------------

model HelpdeskTicket {
  id           String          @id @default(cuid())
  // Human-readable handle for the ticket: printed on the detail screen, encoded
  // in its QR, and emailed to the resident so they can quote it to the office.
  referenceCode String         @unique
  residentId   String
  resident     ResidentProfile @relation(fields: [residentId], references: [id])
  flatId       String
  flat         Flat            @relation(fields: [flatId], references: [id])
  category     TicketCategory
  title        String
  description  String
  photoUrls    String[]
  priority     TicketPriority  @default(MEDIUM)
  status       TicketStatus    @default(OPEN)
  assignedToId String?
  assignedTo   User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  comments TicketComment[]

  @@index([status])
  @@index([residentId])
  @@index([flatId])
}

model TicketComment {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    HelpdeskTicket @relation(fields: [ticketId], references: [id])
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  message   String
  photoUrls String[]
  createdAt DateTime       @default(now())

  @@index([ticketId])
}

model Notice {
  id                 String         @id @default(cuid())
  societyId          String
  society            Society        @relation(fields: [societyId], references: [id])
  title              String
  body               String
  imageUrl           String?
  category           NoticeCategory
  isPinned           Boolean        @default(false)
  publishedByAdminId String
  publishedByAdmin   User           @relation(fields: [publishedByAdminId], references: [id])
  scheduledAt        DateTime?
  createdAt          DateTime       @default(now())

  @@index([societyId])
}

model Poll {
  id               String   @id @default(cuid())
  societyId        String
  society          Society  @relation(fields: [societyId], references: [id])
  question         String
  allowMultiple    Boolean  @default(false)
  deadline         DateTime
  createdByAdminId String
  createdByAdmin   User     @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime @default(now())

  options PollOption[]
  votes   PollVote[]

  @@index([societyId])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])
  text   String

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String          @id @default(cuid())
  pollId     String
  poll       Poll            @relation(fields: [pollId], references: [id])
  optionId   String
  option     PollOption      @relation(fields: [optionId], references: [id])
  residentId String
  resident   ResidentProfile @relation(fields: [residentId], references: [id])
  createdAt  DateTime        @default(now())

  // Single-vote-per-poll (allowMultiple = false) is enforced in the service
  // layer; this constraint prevents duplicate votes on the same option.
  @@unique([pollId, optionId, residentId])
  @@index([pollId])
}

model Amenity {
  id           String   @id @default(cuid())
  societyId    String
  society      Society  @relation(fields: [societyId], references: [id])
  name         String
  description  String?
  photoUrls    String[]
  rules        String?
  // null = free. Free amenities bypass payment entirely and book directly.
  pricePerSlot Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  // Free-cancellation window. Cancelling this many hours or more before the
  // slot refunds; inside it, no refund.
  cancellationHours Int @default(24)

  bookings AmenityBooking[]

  @@index([societyId])
}

model AmenityBooking {
  id         String          @id @default(cuid())
  amenityId  String
  amenity    Amenity         @relation(fields: [amenityId], references: [id])
  residentId String
  resident   ResidentProfile @relation(fields: [residentId], references: [id])
  date       DateTime        @db.Date
  startTime  String // "HH:mm", 24h
  endTime    String // "HH:mm", 24h
  status     BookingStatus   @default(BOOKED)
  // Price snapshot taken when the booking was made, so a later change to
  // Amenity.pricePerSlot can't alter what an existing booking owes. null on
  // bookings of free amenities.
  amountDue  Decimal?        @db.Decimal(10, 2)
  // When a PENDING_PAYMENT hold lapses. Null once the booking is settled.
  holdExpiresAt DateTime?
  createdAt  DateTime        @default(now())

  payments Payment[]

  @@index([amenityId, date])
  @@index([residentId])
  // Drives the sweep that releases lapsed holds.
  @@index([status, holdExpiresAt])
}

// ---------------------------------------------------------------------------
// DUES & PAYMENTS
// ---------------------------------------------------------------------------

model MaintenanceDue {
  id      String    @id @default(cuid())
  flatId  String
  flat    Flat      @relation(fields: [flatId], references: [id])
  month   Int // 1-12
  year    Int
  amount  Decimal   @db.Decimal(10, 2)
  dueDate DateTime
  status  DueStatus @default(PENDING)

  payments Payment[]

  @@unique([flatId, month, year])
  @@index([flatId])
  @@index([status])
}

/**
 * A payment attempt against exactly one target: a maintenance due, an amenity
 * booking, or a service bill. The three FKs are nullable and a CHECK
 * constraint (see the migration) enforces that precisely one is set — keeping
 * referential integrity while letting one payment pipeline serve all three.
 */
model Payment {
  id            String          @id @default(cuid())
  // onDelete: Restrict on all three — an optional FK would otherwise default to
  // SET NULL, which nulls the only target and violates the exactly-one CHECK.
  // Restrict fails the delete outright, which is the honest error.
  dueId         String?
  due           MaintenanceDue? @relation(fields: [dueId], references: [id], onDelete: Restrict)
  bookingId     String?
  booking       AmenityBooking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  serviceBillId String?
  serviceBill   ServiceBill?    @relation(fields: [serviceBillId], references: [id], onDelete: Restrict)
  residentId    String
  resident      ResidentProfile @relation(fields: [residentId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  method        PaymentMethod
  transactionId String?         @unique
  status        PaymentStatus   @default(INITIATED)
  paidAt        DateTime?

  // UPI_DIRECT only — the payer-entered UTR. Evidence, not proof: the payer
  // types it themselves, so it carries the same trust as an offline receipt.
  upiUtr String?

  // OFFLINE payments only — the uploaded receipt.
  receiptUrl String?
  note       String?

  // The human decision on a manual-rail payment: an admin verifying/rejecting
  // an offline receipt or a UPI-direct claim, or reversing a self-attested
  // service-bill payment.
  verifiedByAdminId String?
  verifiedByAdmin   User?     @relation("PaymentVerifiedByAdmin", fields: [verifiedByAdminId], references: [id])
  verifiedAt        DateTime?
  rejectionReason   String?

  createdAt     DateTime        @default(now())

  @@index([dueId])
  @@index([bookingId])
  @@index([serviceBillId])
  @@index([residentId])
  // Drives the admin verification queue.
  @@index([status])
}

/**
 * A bill a resident owes an individual service person (maid, electrician, …).
 *
 * Raised by the resident, not the service person: ServiceProvider is a
 * directory row with no User behind it, so a service person cannot log in to
 * raise a bill, confirm a payment, or complete Razorpay KYC. That is also why
 * these are never payable on the gateway rail — only UPI-direct or offline.
 */
model ServiceBill {
  id                String          @id @default(cuid())
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  residentId        String
  resident          ResidentProfile @relation(fields: [residentId], references: [id])
  amount            Decimal         @db.Decimal(10, 2)
  description       String?
  // Free-text billing period, e.g. "July 2026" — service work is billed by
  // arrangement, not on a fixed cycle, so this is a label rather than a date.
  periodLabel String?
  status      DueStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  payments Payment[]

  @@index([residentId])
  @@index([serviceProviderId])
}

/**
 * Gateway webhook de-duplication. Razorpay retries deliveries, so the
 * provider's own event id is recorded here and a replay is a no-op. Keyed on
 * the provider id itself rather than on payment status, which cannot
 * distinguish a replay from a second legitimate event on one payment.
 */
model WebhookEvent {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// SUBSCRIPTIONS (the society's own bill to us)
// ---------------------------------------------------------------------------

/**
 * A purchasable plan. Rows rather than constants so prices can change without
 * a deploy, and so a past payment can point at exactly what was sold — a
 * hardcoded plan that later changes price rewrites history.
 */
model Plan {
  id          String  @id @default(cuid())
  code        String  @unique // stable machine key, e.g. "starter"
  name        String
  description String?
  /** Price for one billing interval, in rupees. 0 is a valid free tier. */
  price        Decimal @db.Decimal(10, 2)
  /** Billing period length. Monthly is 1; an annual plan is 12. */
  intervalMonths Int    @default(1)
  /** Bullet points shown on the plan card. */
  features    String[]
  /** Soft cap on flats; null = unlimited. Enforcement is a later concern. */
  maxFlats    Int?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@index([isActive, sortOrder])
}

/**
 * One per society — a society has at most one subscription, which changes plan
 * rather than accumulating rows. Payment history lives in SubscriptionPayment.
 */
model Subscription {
  id        String  @id @default(cuid())
  societyId String  @unique
  society   Society @relation(fields: [societyId], references: [id])
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  /** Paid-through window. Access decisions read currentPeriodEnd, not payments. */
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  /**
   * When GRACE turns into EXPIRED. Set on entering grace so the window is
   * fixed at that moment rather than recomputed from a config that may change.
   */
  graceEndsAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]

  // Drives the sweep that moves lapsed subscriptions through grace to expiry.
  @@index([status, currentPeriodEnd])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])
  amount         Decimal      @db.Decimal(10, 2)

  /** Razorpay's order id, created at checkout; the webhook arrives with it. */
  razorpayOrderId   String  @unique
  /** Razorpay's payment id, known only once captured. */
  razorpayPaymentId String?

  status PaymentStatus @default(INITIATED)
  paidAt DateTime?

  /** The window this payment bought, stamped when it succeeds. */
  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// STAFF & SERVICE DIRECTORY
// ---------------------------------------------------------------------------

model ServiceProvider {
  id             String          @id @default(cuid())
  societyId      String
  society        Society         @relation(fields: [societyId], references: [id])
  name           String
  category       ServiceCategory
  phone          String
  photoUrl       String?
  isVerified     Boolean         @default(false)
  addedByAdminId String
  addedByAdmin   User            @relation(fields: [addedByAdminId], references: [id])

  // Optional. Set = residents can pay this person over UPI-direct; unset =
  // offline only. There is deliberately no linked account here: see ServiceBill.
  upiVpa String?

  bills ServiceBill[]

  @@index([societyId, category])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model PushToken {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  token      String
  deviceType DeviceType
  createdAt  DateTime   @default(now())

  @@unique([userId, token])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
