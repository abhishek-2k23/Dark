{
  "name": "@repo/database",
  "version": "1.0.0",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx seed.ts",
    "db:seed:plans": "dotenv -e ../../.env -- tsx seed-plans.ts",
    "db:format": "prisma format",
    "check-types": "tsc --noEmit",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "dev": "dotenv -e ../../.env -- prisma studio"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  }
}
